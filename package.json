{
	"name": "opshot",
	"version": "0.3.1",
	"description": "Plain-object state for React: mutate it directly, re-render only the components that read what changed, and track every change operation",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"author": "Matt Cavender",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/visionsofparadise/opshot.git"
	},
	"scripts": {
		"check": "prettier --write . && eslint . --fix --cache && concurrently \"tsc --noEmit\" \"markdownlint-cli2 \\\"**/*.md\\\"\" \"textlint \\\"**/*.md\\\"\" \"knip --no-progress\" \"jscpd .\"",
		"lint": "eslint . --fix --cache",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"unit": "vitest run unit",
		"integration": "vitest run integration",
		"build": "tsup --config tsup.config.ts"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.3.2",
		"@eslint/js": "^9.39.5",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.17",
		"concurrently": "^10.0.3",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-barrel-files": "^3.0.1",
		"eslint-plugin-check-file": "^3.3.1",
		"eslint-plugin-comment-rules": "^0.1.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.7.0",
		"jscpd": "^5.0.12",
		"jsdom": "^29.1.1",
		"knip": "^6.29.0",
		"markdownlint-cli2": "^0.23.1",
		"prettier": "^3.6.2",
		"proxy-compare": "^3.0.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"textlint": "^15.2.2",
		"textlint-filter-rule-comments": "^1.2.2",
		"textlint-rule-no-dead-link": "^6.2.1",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.64.0",
		"valtio": "2.3.2",
		"vitest": "^4.1.10"
	},
	"allowScripts": {
		"esbuild@0.27.7": true,
		"unrs-resolver@1.12.2": true
	}
}
